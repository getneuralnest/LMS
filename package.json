{
  "name": "class-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "env:check": "node scripts/env-check.mjs",
    "dev": "npm run env:check && next dev",
    "build": "next build",
    "vercel-build": "npm run env:check && next build",
    "start": "next start",
    "lint": "npm run env:check && eslint .",
    "typecheck": "npm run env:check && tsc --noEmit",
    "test:unit": "npm run env:check && vitest run",
    "test:e2e": "npm run env:check && playwright test",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:test": "npx supabase test db",
    "seed:admin": "npm run env:check && node scripts/seed-admin.mjs",
    "seed:students": "npm run env:check && node scripts/seed-students.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "restore:storage": "node scripts/restore-storage.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "supabase": "^3.4.0",
    "typescript": "latest",
    "vitest": "latest"
  }
}
